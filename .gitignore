# ==========================================
# LinkUp — Master .gitignore (Security & Build)
# ==========================================

# Environment variables & secrets (CRITICAL: Never commit!)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Python Virtual Environments & Bytecode
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Build outputs
dist/
out/
.next/
.nuxt/
.output/

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Uploads and temporary assets
uploads/
temp/
tmp/
*.tmp

# Operating System & IDE files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Coverage
coverage/
.nyc_output/
.coverage
htmlcov/
.neon
